pipeline {
    agent none

    environment {
        JAR_WIREMOCK = '/opt/jenkins-libs/wiremock-jre8-standalone-2.28.0.jar'
        PYTHONUNBUFFERED = '1'
    }

    stages {
        stage('Get Code') {
            agent { label 'agente-02' }
            steps {
                echo 'Clonando repositorio'
                sh 'whoami && hostname && echo $WORKSPACE'
                checkout scm
                stash name: 'codigo', includes: '**/*'
            }
        }

        stage('Tests') {
            parallel {
                stage('Unit Tests') {
                    agent { label 'agente-02' }
                    steps {
                        echo 'Ejecutando tests unitarios'
                        sh 'whoami && hostname && echo $WORKSPACE'
                        unstash 'codigo'

                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''
                                export PYTHONPATH=$WORKSPACE
                                python3-coverage run --branch --source=app --omit=app/__init__.py,app/api.py -m pytest --junitxml=result-unit.xml test/unit
                                python3-coverage xml
                            '''
                        }

                        stash name: 'unit-results', includes: 'result-unit.xml'
                        stash name: 'coverage-results', includes: 'coverage.xml'
                    }
                }

                stage('Integration Tests') {
                    agent { label 'agente-02' }
                    steps {
                        echo 'Ejecutando tests de integración'
                        sh 'whoami && hostname && echo $WORKSPACE'
                        unstash 'codigo'

                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''
                                echo "== Preparando entorno de pruebas =="

                                mkdir -p mocks/mappings
                                cp test/wiremock/mappings/*.json mocks/mappings/

                                export FLASK_APP=app/api.py
                                export FLASK_ENV=development
                                flask run --host=127.0.0.1 --port=5000 &

                                echo "== Lanzando WireMock =="
                                nohup java -jar $JAR_WIREMOCK --port 9090 --root-dir mocks > wiremock.log 2>&1 &

                                echo "== Esperando a que WireMock exponga el puerto 9090... =="
                                for i in {1..30}; do
                                    nc -z localhost 9090 && break
                                    sleep 1
                                done

                                if ! nc -z localhost 9090; then
                                    echo "ERROR: WireMock no está disponible tras 30s"
                                    tail -n 20 wiremock.log || true
                                    exit 1
                                fi

                                echo "== WireMock disponible =="
                                export PYTHONPATH=$WORKSPACE
                                pytest --junitxml=result-rest.xml test/rest
                            '''
                        }

                        stash name: 'rest-results', includes: 'result-rest.xml'
                    }
                }
            }
        }

                stage('Coverage') {
                     agent { label 'agente-02' }
                     steps {
                         echo 'Publicando análisis de cobertura'
                         sh 'whoami && hostname && echo $WORKSPACE'
                         unstash 'coverage-results'

                         catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                             recordCoverage(
                                 tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                                 qualityGates: [
                                     [threshold: 85.0, metric: 'LINE',   baseline: 'PROJECT', criticality: 'UNSTABLE'],
                                     [threshold: 95.0, metric: 'LINE',   baseline: 'PROJECT', criticality: 'FAILURE'],
                                     [threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'UNSTABLE'],
                                     [threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'FAILURE']
                                 ]
                             )
                         }
                     }
                 }

        stage('Static') {
            agent { label 'agente-02' }
            steps {
                echo 'Ejecutando análisis estático con Flake8'
                sh 'whoami && hostname && echo $WORKSPACE'
                unstash 'codigo'

                sh '''
                    flake8 --exit-zero --format=pylint app > flake8.out
                '''
                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                             qualityGates: [
                                 [threshold: 8,  type: 'TOTAL', unstable: true],
                                 [threshold: 10, type: 'TOTAL', unstable: false]
                             ]
            }
        }

        stage('Security') {
            agent { label 'agente-02' }
            steps {
                echo 'Ejecutando análisis con Bandit'
                sh 'whoami && hostname && echo $WORKSPACE'
                unstash 'codigo'

                sh '''
                    bandit -r app -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}" || true
                '''
                recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                             qualityGates: [
                                 [threshold: 2, type: 'TOTAL', unstable: true],
                                 [threshold: 4, type: 'TOTAL', unstable: false]
                             ]
            }
        }

        stage('Performance') {
            agent { label 'agente-02' }
            steps {
                echo 'Ejecutando pruebas con JMeter'
                sh 'whoami && hostname && echo $WORKSPACE'
                unstash 'codigo'

                sh '''
                    export PATH=/opt/jmeter/bin:$PATH

                    export FLASK_APP=app/api.py
                    export FLASK_ENV=development
                    flask run --host=127.0.0.1 --port=5000 > flask.log 2>&1 &

                    echo "== Esperando a que Flask esté disponible =="
                    for i in {1..30}; do
                        nc -z localhost 5000 && break
                        sleep 1
                    done

                    if ! nc -z localhost 5000; then
                        echo "ERROR: Flask no está disponible tras 30s"
                        tail -n 20 flask.log || true
                        exit 1
                    fi

                    echo "== Flask up, lanzando JMeter =="
                    rm -f test/jmeter/results.jtl
                    /opt/jmeter/bin/jmeter -n -t test/jmeter/flask.jmx -l test/jmeter/results.jtl

                    echo "== Pruebas finalizadas =="
                    pkill -f "flask run" || true
                '''
            }
            post {
                always {
                    perfReport sourceDataFiles: 'test/jmeter/results.jtl'
                }
            }
        }

        stage('Results') {
            agent { label 'agente-02' }
            steps {
                echo 'Mostrando resultados finales de los tests'
                unstash 'unit-results'
                unstash 'rest-results'
                junit 'result-*.xml'
            }
            post {
                always {
                    cleanWs()
                }
            }
        }
    }
}
